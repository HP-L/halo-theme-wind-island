<footer
  class="site-footer dot-surface"
>
  <span class="site-footer__corner site-footer__corner--left" aria-hidden="true"></span>
  <span class="site-footer__corner site-footer__corner--right" aria-hidden="true"></span>
  <div class="container footer-grid">
    <p class="footer-copyright">
      <span>&copy;</span>
      <%
        var startYear = theme.footer && theme.footer.copyright_start_year ? theme.footer.copyright_start_year : '';
        var currentYear = new Date().getFullYear().toString();
        var displayYear = startYear && startYear !== currentYear ? startYear + '-' + currentYear : currentYear;
      %>
      <span><%= displayYear %></span>
      <span class="footer-copyright__separator" aria-hidden="true">&middot;</span>
      <span><%= config.title %></span>
      <span class="footer-copyright__separator" aria-hidden="true">&middot;</span>
      <a href="https://github.com/HP-L/halo-theme-wind-island" target="_blank" rel="noopener noreferrer"><span data-i18n="footer.theme" data-i18n-args="[&quot;风屿&quot;]"><%= __('footer.theme', '风屿') %></span></a>
    </p>
    <%
      var icpNumber = theme.footer && theme.footer.icp_number ? theme.footer.icp_number : '';
      var publicSecurityNumber = theme.footer && theme.footer.public_security_number ? theme.footer.public_security_number : '';
      var icpUrl = theme.footer && theme.footer.icp_url ? theme.footer.icp_url : 'https://beian.miit.gov.cn/';
      var publicSecurityUrl = theme.footer && theme.footer.public_security_url ? theme.footer.public_security_url : 'https://beian.mps.gov.cn/#/query/webSearch';
      var publicSecurityIcon = theme.footer && theme.footer.public_security_icon ? theme.footer.public_security_icon : '';
    %>
    <% if (icpNumber || publicSecurityNumber) { %>
    <ul class="footer-filings" role="list" aria-label="<%= __('footer.filings') %>" data-i18n-mode="aria-label" data-i18n="footer.filings">
      <% if (icpNumber) { %>
      <li>
        <a class="footer-filing footer-filing--icp" href="<%= icpUrl %>" target="_blank" rel="noopener noreferrer">
          <span class="footer-filing__monogram" aria-hidden="true" data-i18n="footer.icp"><%= __('footer.icp') %></span>
          <span><%= icpNumber %></span>
        </a>
      </li>
      <% } %>
      <% if (publicSecurityNumber) { %>
      <li>
        <a class="footer-filing footer-filing--public-security" href="<%= publicSecurityUrl %>" target="_blank" rel="noopener noreferrer">
          <% if (publicSecurityIcon) { %>
          <img class="footer-filing__icon" src="<%= publicSecurityIcon %>" alt="" width="16" height="16" />
          <% } else { %>
          <svg class="footer-filing__icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 3 5.5 5.6v5.3c0 4.3 2.7 8.1 6.5 9.3 3.8-1.2 6.5-5 6.5-9.3V5.6L12 3Z" />
            <path d="m12 7 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5L11 9Z" />
          </svg>
          <% } %>
          <span><%= publicSecurityNumber %></span>
        </a>
      </li>
      <% } %>
    </ul>
    <% } %>
  </div>
</footer>
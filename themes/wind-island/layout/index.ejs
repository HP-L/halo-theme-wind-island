<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">
      <span data-i18n="page.index.welcome"><%= __('page.index.welcome') %></span>
      <strong><%= config.title %></strong>
      <span class="hero-tagline" data-solar-term><span class="solar-term--shuangjiang">春分</span>将至</span>
    </h1>
    <p><%= config.subtitle || config.description %></p>
    <div class="hero-actions">
      <a class="button button--primary" href="<%- url_for('/archives') %>" data-i18n="common.readPost"><%= __('common.readPost') %></a>
      <a class="button button--secondary" href="<%- url_for('/categories') %>" data-i18n="page.index.browseCategories"><%= __('page.index.browseCategories') %></a>
    </div>
  </div>

  <div class="hero-media">
    <div class="hero-orbit">
      <img
        src="<%- url_for('/images/wind-island-hero-1.png') %>"
        alt="<%= __('page.index.heroImageAlt', config.title) %>"
      />
    </div>
  </div>
</section>

<% var coverStripSource = theme.home && theme.home.cover_strip_source ? theme.home.cover_strip_source : 'pinned'; %>
<% var pinnedPosts = []; if (coverStripSource === 'pinned') { %>
  <% site.posts.forEach(function(post) { if (post.pinned) pinnedPosts.push(post); }); %>
  <% if (pinnedPosts.length) { %>
  <section class="cover-strip" aria-label="<%= __('page.index.pinnedPosts') %>" data-i18n-mode="aria-label" data-i18n="page.index.pinnedPosts">
    <div class="cover-strip__track">
      <div class="cover-strip__set">
        <% pinnedPosts.forEach(function(post) { %>
        <a class="cover-tile" href="<%- url_for(post.path) %>">
          <img
            src="<%= post.cover || url_for('/images/wind-island-hero-1.png') %>"
            alt="<%= post.title %>"
            loading="lazy"
          />
          <div class="cover-tile__info">
            <span class="cover-tile__title"><%= post.title %></span>
            <span class="cover-tile__author"><%= post.author || config.author %></span>
          </div>
        </a>
        <% }); %>
      </div>
      <div class="cover-strip__set" aria-hidden="true">
        <% pinnedPosts.forEach(function(post) { %>
        <span class="cover-tile">
          <img src="<%= post.cover || url_for('/images/wind-island-hero-1.png') %>" alt="" loading="lazy" />
          <div class="cover-tile__info">
            <span class="cover-tile__title"><%= post.title %></span>
            <span class="cover-tile__author"><%= post.author || config.author %></span>
          </div>
        </span>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>
<% } %>

<section class="story-grid container section" aria-labelledby="topics-title" data-reveal>
  <aside class="panel topic-panel" data-reveal>
    <p class="eyebrow" data-i18n="page.index.collectionsEyebrow"><%= __('page.index.collectionsEyebrow') %></p>
    <h2 id="topics-title" data-i18n="page.index.collectionsTitle"><%= __('page.index.collectionsTitle') %></h2>
    <%
      var topicCategories = theme.home && theme.home.topic_categories ? theme.home.topic_categories : [];
      if (Array.isArray(topicCategories) && topicCategories.length > 0) {
        // Show configured topic categories
        topicCategories.forEach(function(catName, index) {
          var cat = site.categories.findOne({name: catName});
          if (cat) {
    %>
    <ul class="topic-list">
      <li>
        <a href="<%- url_for(cat.path) %>">
          <span class="topic-list__mark"><%= (index < 9 ? '0' : '') + (index + 1) %></span>
          <span class="topic-list__copy">
            <strong><%= cat.name %></strong>
            <small><%= __('common.postsCount', cat.posts.length) %></small>
          </span>
          <span class="topic-list__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </li>
    </ul>
    <%
          }
        });
      } else {
        // Default: show first 12 categories
        var cats = site.categories.toArray().slice(0, 12);
        if (cats.length) {
    %>
    <ul class="topic-list">
      <% cats.forEach(function(cat, index) { %>
      <li>
        <a href="<%- url_for(cat.path) %>">
          <span class="topic-list__mark"><%= (index < 9 ? '0' : '') + (index + 1) %></span>
          <span class="topic-list__copy">
            <strong><%= cat.name %></strong>
            <small><%= __('common.postsCount', cat.posts.length) %></small>
          </span>
          <span class="topic-list__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p><%= __('page.index.emptyCategories') %></p>
    <% } %>
    <% } %>
  </aside>
</section>

<%
  var featuredCategoryName = theme.home && theme.home.featured_category ? theme.home.featured_category : '';
  var featuredCategory = null;
  var featuredPosts = page.posts;
  if (featuredCategoryName) {
    featuredCategory = site.categories.findOne({name: featuredCategoryName});
    if (featuredCategory) {
      featuredPosts = featuredCategory.posts.sort('date', -1);
    }
  }
%>
<section class="section container featured-section" aria-labelledby="work-title">
  <header class="section-heading" data-reveal>
    <div>
      <p class="eyebrow" data-i18n="page.index.featuredEyebrow"><%= __('page.index.featuredEyebrow') %></p>
      <h2 id="work-title"><%= featuredCategory ? featuredCategory.name : __('page.index.recentPosts') %></h2>
      <p data-i18n="page.index.recentDescription"><%= featuredCategory ? (featuredCategory.description || '') : __('page.index.recentDescription') %></p>
    </div>
    <a class="text-link" href="<%- featuredCategory ? url_for(featuredCategory.path) : url_for('/archives') %>" data-i18n="<%= featuredCategory ? 'page.index.viewCategory' : 'page.index.viewAllPosts' %>">
      <%= featuredCategory ? __('page.index.viewCategory') : __('page.index.viewAllPosts') %>
    </a>
  </header>

  <% if (featuredPosts && featuredPosts.length) { %>
  <div class="featured-grid">
    <%
      var cards = featuredPosts.toArray ? featuredPosts.toArray().slice(0, 8) : featuredPosts.data.slice(0, 8);
      var cardColors = ['var(--card-violet)', 'var(--card-rose)', 'var(--card-indigo)', 'var(--card-green)'];
      cards.forEach(function(post, index) {
        var accentColor = cardColors[index % 4];
        var delay = (index % 2) * 70;
    %>
    <article class="featured-card" data-reveal style="--card-accent: <%= accentColor %>; --reveal-delay: <%= delay %>ms;">
      <span class="featured-card__glow" aria-hidden="true"></span>
      <div class="featured-card__body">
        <p class="post-meta">
          <time><%= date(post.date, 'YYYY.MM.DD') %></time>
          <% if (post.categories && post.categories.length) { %>
            &middot; <span><%= post.categories.first().name %></span>
          <% } %>
        </p>
        <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
        <% if (post.excerpt) { %><p><%= post.excerpt %></p><% } %>
        <div class="featured-card__actions">
          <a class="button button--primary button--small" href="<%- url_for(post.path) %>" data-i18n="common.readPost"><%= __('common.readPost') %></a>
          <% if (post.categories && post.categories.length) { %>
          <a class="button button--ghost button--small" href="<%- url_for(post.categories.first().path) %>"><%= post.categories.first().name %></a>
          <% } %>
        </div>
      </div>
    </article>
    <% }); %>
  </div>
  <% } else { %>
  <p class="empty-state" data-i18n="page.index.emptyPosts"><%= __('page.index.emptyPosts') %></p>
  <% } %>

  <% if (!featuredCategory) { %>
  <%- partial('_partial/pagination') %>
  <% } %>
</section>